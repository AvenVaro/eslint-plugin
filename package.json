{
  "name": "eslint-plugin-avenvaro",
  "version": "1.0.0",
  "description": "Strict structural alignment, operator grid formatting, and syntax delimiter placement rules for ESLint.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "editorconfig": "editorconfig-checker",
    "lint": "eslint . && editorconfig-checker",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "@stylistic/eslint-plugin": ">=5.0.0"
  },
  "dependencies": {
    "editorconfig": "^1.0.4"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "formatter",
    "style",
    "layout",
    "grid",
    "indent",
    "js-indent"
  ],
  "author": "Aven Varo",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "editorconfig-checker": "^6.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-jsonc": "^3.3.0",
    "eslint-plugin-yml": "^3.6.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "yaml-eslint-parser": "^2.1.0"
  },
  "files": [
    "src",
    "infrastructure",
    "LICENSE",
    "NOTICE",
    "README.md"
  ]
}
